# Optional: everything below has a working local default.
# To override, copy this file to .env and change the values you need.

# Product data: "fakestore" (live API) or "fixture" (bundled copy, works offline)
PRODUCT_SOURCE=fakestore
FAKE_STORE_BASE_URL=https://fakestoreapi.com
CACHE_TTL_SECONDS=60

# Email: defaults point at the local Mailpit catcher
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ENQUIRY_FROM=catalogue@example.com
SALES_INBOX=sales@example.com

# API server
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Only set to true behind a proxy that overwrites X-Forwarded-For
TRUST_PROXY=false
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
